<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DentalCenter.Controls.DetailPageView"
             FlowDirection="RightToLeft">

    <Grid ColumnDefinitions="230,*">

        <!-- ستون فهرست موضوع‌ها -->
        <Border Grid.Column="0"
                Background="{DynamicResource DcSurfaceAltBrush}"
                CornerRadius="14"
                Padding="10">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,10">
                    <TextBlock x:Name="SectionTitle"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DcBrandDarkBrush}"/>
                    <Rectangle Height="2"
                               Margin="0,8,0,0"
                               Fill="{DynamicResource DcBrandBrush}"
                               Opacity="0.35"/>
                </StackPanel>

                <ListBox x:Name="TopicList"
                         Classes="topics"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnTopicChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ButtonText}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>

        </Border>

        <!-- ستون محتوا -->
        <ScrollViewer Grid.Column="1" Margin="16,0,0,0">

            <StackPanel Spacing="14">

                <TextBlock x:Name="TopicTitle"
                           FontSize="26"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="TopicSummary"
                           FontSize="15"
                           Opacity="0.8"
                           LineHeight="26"
                           TextWrapping="Wrap"/>

                <Border CornerRadius="14"
                        ClipToBounds="True"
                        Height="290"
                        Background="{DynamicResource DcBrandLightBrush}">
                    <Panel>
                        <TextBlock x:Name="ImageFallback"
                                   Text="تصویر در دسترس نیست"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image x:Name="TopicImage"
                               Stretch="UniformToFill"
                               FlowDirection="LeftToRight"/>
                    </Panel>
                </Border>

                <!-- نکات کلیدی طراحی -->
                <StackPanel x:Name="BulletsSection" Spacing="10">
                    <TextBlock Text="نکات کلیدی طراحی"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DcBrandDarkBrush}"/>
                    <ItemsControl x:Name="BulletsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,0,9">
                                    <Ellipse Width="7" Height="7"
                                             Margin="0,8,0,0"
                                             VerticalAlignment="Top"
                                             Fill="{DynamicResource DcBrandBrush}"/>
                                    <TextBlock Text="{Binding}"
                                               FontSize="14"
                                               LineHeight="25"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- مشخصات فنی -->
                <StackPanel x:Name="SpecsSection" Spacing="10">
                    <TextBlock Text="مشخصات فنی"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DcBrandDarkBrush}"/>
                    <Border Classes="card" Padding="8">
                        <ItemsControl x:Name="SpecsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,*" Margin="8,7">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Key}"
                                                   FontSize="13.5"
                                                   Opacity="0.72"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- واژگان کلیدی -->
                <StackPanel x:Name="KeywordsSection" Spacing="10" IsVisible="False">
                    <TextBlock Text="واژگان کلیدی"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource DcBrandDarkBrush}"/>
                    <Border Classes="card" Padding="14">
                        <TextBlock x:Name="KeywordsText"
                                   FontSize="13.5"
                                   LineHeight="24"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DcBrandDarkBrush}"/>
                    </Border>
                </StackPanel>

                <!-- نکتهٔ بهره‌وری انرژی -->
                <Border x:Name="EnergyNoteSection"
                        IsVisible="False"
                        CornerRadius="14"
                        Padding="16"
                        Background="#E8F5E9"
                        BorderBrush="#A5D6A7"
                        BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="💡 نکتهٔ بهره‌وری انرژی"
                                   FontWeight="Bold"
                                   FontSize="14.5"
                                   Foreground="#2E7D32"/>
                        <TextBlock x:Name="EnergyNoteText"
                                   FontSize="13.5"
                                   LineHeight="24"
                                   TextWrapping="Wrap"
                                   Foreground="#1B5E20"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,10">
                    <Button x:Name="btnPdf"
                            Classes="primary"
                            Content="📄  مشاهده PDF"
                            Width="170"/>
                    <TextBlock x:Name="PdfHint"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Opacity="0.65"
                               TextWrapping="Wrap"/>
                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
