<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DentalCenter.Controls.DetailPageView"
             FlowDirection="RightToLeft">

    <Grid ColumnDefinitions="230,*">

        <!-- ستون فهرست موضوع‌ها -->
        <Border Grid.Column="0"
                Background="{DynamicResource DcSurfaceAltBrush}"
                CornerRadius="14"
                Padding="10">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,10">
                    <TextBlock x:Name="SectionTitle"
                               FontSize="18"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DcBrandDarkBrush}"/>
                    <Rectangle Height="2"
                               Margin="0,8,0,0"
                               Fill="{DynamicResource DcBrandBrush}"
                               Opacity="0.35"/>
                </StackPanel>

                <ListBox x:Name="TopicList"
                         Classes="topics"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnTopicChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ButtonText}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>

        </Border>

        <!-- ستون محتوا -->
        <ScrollViewer Grid.Column="1" Margin="16,0,0,0">

            <StackPanel Spacing="14">

                <TextBlock x:Name="TopicTitle"
                           FontSize="26"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="TopicSummary"
                           FontSize="15"
                           Opacity="0.8"
                           LineHeight="26"
                           TextWrapping="Wrap"/>

                <Border CornerRadius="14"
                        ClipToBounds="True"
                        Height="290"
                        Background="{DynamicResource DcBrandLightBrush}">
                    <Panel>
                        <TextBlock x:Name="ImageFallback"
                                   Text="تصویر در دسترس نیست"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image x:Name="TopicImage"
                               Stretch="UniformToFill"
                               FlowDirection="LeftToRight"/>
                    </Panel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,10">
                    <Button x:Name="btnPdf"
                            Classes="primary"
                            Content="📄  مشاهده PDF"
                            Width="170"/>
                    <TextBlock x:Name="PdfHint"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Opacity="0.65"
                               TextWrapping="Wrap"/>
                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
