<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DentalCenter.Views.FeedbackView"
             FlowDirection="RightToLeft">

    <Grid ColumnDefinitions="*,*">

        <!-- فرم ثبت نظر -->
        <ScrollViewer Grid.Column="0" Margin="0,0,10,0">

            <StackPanel Spacing="14">

                <TextBlock Text="ثبت نظر"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock Text="نظر شما دربارهٔ این ارائه ذخیره می‌شود و در فهرست کنار نمایش داده خواهد شد."
                           FontSize="13.5"
                           Opacity="0.7"
                           LineHeight="24"
                           TextWrapping="Wrap"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="نام و نام خانوادگی" FontSize="12.5" Opacity="0.7"/>
                    <TextBox x:Name="NameBox" Watermark="مثال: علی رضایی"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="ایمیل (اختیاری)" FontSize="12.5" Opacity="0.7"/>
                    <TextBox x:Name="EmailBox" Watermark="name@example.com"
                             FlowDirection="LeftToRight"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="موضوع" FontSize="12.5" Opacity="0.7"/>
                    <ComboBox x:Name="SubjectBox"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="0">
                        <ComboBoxItem>نظر کلی</ComboBoxItem>
                        <ComboBoxItem>تجهیزات</ComboBoxItem>
                        <ComboBoxItem>فضای فیزیکی</ComboBoxItem>
                        <ComboBoxItem>بهره‌وری انرژی</ComboBoxItem>
                        <ComboBoxItem>بخش کودکان</ComboBoxItem>
                        <ComboBoxItem>پیشنهاد بهبود</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="امتیاز" FontSize="12.5" Opacity="0.7"/>
                    <StackPanel x:Name="StarPanel"
                                Orientation="Horizontal"
                                Spacing="4"/>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="متن نظر" FontSize="12.5" Opacity="0.7"/>
                    <TextBox x:Name="MessageBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="150"
                             Watermark="نظر خود را اینجا بنویسید..."/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="btnSubmit"
                            Classes="primary"
                            Content="✔  ثبت نظر"
                            Width="150"/>
                    <Button x:Name="btnReset"
                            Content="پاک کردن فرم"
                            Width="130"/>
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           FontSize="13"
                           TextWrapping="Wrap"
                           IsVisible="False"/>

            </StackPanel>

        </ScrollViewer>

        <!-- فهرست نظرات ثبت‌شده -->
        <Border Grid.Column="1"
                Margin="10,0,0,0"
                CornerRadius="14"
                Padding="14"
                Background="{DynamicResource DcSurfaceAltBrush}">

            <DockPanel>

                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="نظرات ثبت‌شده"
                                   FontSize="17"
                                   FontWeight="Bold"/>
                        <TextBlock x:Name="CountText"
                                   FontSize="12"
                                   Opacity="0.6"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            x:Name="btnClear"
                            Content="حذف همه"
                            FontSize="12.5"
                            Height="34"
                            Padding="12,0"/>
                </Grid>

                <TextBlock x:Name="EmptyText"
                           DockPanel.Dock="Top"
                           Text="هنوز نظری ثبت نشده است."
                           Opacity="0.55"
                           HorizontalAlignment="Center"
                           Margin="0,40,0,0"/>

                <ScrollViewer>
                    <ItemsControl x:Name="FeedbackList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" Margin="0,0,0,10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Header}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Stars}"
                                                       Foreground="#F9A825"
                                                       FontSize="14"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Message}"
                                                   FontSize="13.5"
                                                   LineHeight="24"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.85"/>
                                        <TextBlock Text="{Binding CreatedAtText}"
                                                   FontSize="11.5"
                                                   Opacity="0.5"
                                                   FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </DockPanel>

        </Border>

    </Grid>

</UserControl>
