<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DentalCenter.Views.CommentsView"
             FlowDirection="RightToLeft">

    <DockPanel Margin="0,14,0,0">

        <!-- سرتیتر و خلاصهٔ آماری -->
        <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,16">

            <Grid ColumnDefinitions="*,Auto">

                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="💬  نمایش نظرات"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock Text="همهٔ نظرهای ثبت‌شده در پایگاه دادهٔ برنامه."
                               FontSize="13"
                               Opacity="0.65"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="btnRefresh" Content="🔄  تازه‌سازی" Height="38"/>
                    <Button x:Name="btnClear" Content="حذف همه" Height="38"/>
                </StackPanel>

            </Grid>

            <!-- جست‌وجو -->
            <Grid ColumnDefinitions="*">
                <TextBox Grid.Column="0"
                         x:Name="SearchBox"
                         Watermark="جست‌وجو در نام، موضوع یا متن نظر..."/>
            </Grid>

        </StackPanel>

        <!-- پیام خالی بودن -->
        <StackPanel x:Name="EmptyPanel"
                    DockPanel.Dock="Top"
                    Spacing="8"
                    Margin="0,50,0,0"
                    IsVisible="False">
            <TextBlock Text="💬"
                       FontSize="46"
                       Opacity="0.3"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyText"
                       Opacity="0.6"
                       FontSize="14"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- فهرست نظرها -->
        <ScrollViewer>
            <ItemsControl x:Name="CommentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*">

                                <Border Grid.Column="0"
                                        Width="46" Height="46"
                                        CornerRadius="23"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource DcBrandLightBrush}">
                                    <TextBlock Text="{Binding Initial}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DcBrandDarkBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="13,0,0,0" Spacing="7">

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold"
                                                   FontSize="14.5"/>
                                        <TextBlock Text="{Binding Subject}"
                                                   FontSize="12"
                                                   Opacity="0.6"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Message}"
                                               FontSize="13.5"
                                               LineHeight="25"
                                               TextWrapping="Wrap"
                                               Opacity="0.88"/>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CreatedAtText}"
                                                   FontSize="11.5"
                                                   Opacity="0.5"
                                                   FlowDirection="LeftToRight"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="حذف"
                                                FontSize="11.5"
                                                Height="28"
                                                Padding="12,0"
                                                Tag="{Binding Id}"
                                                Click="OnDeleteClick"/>
                                    </Grid>

                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>