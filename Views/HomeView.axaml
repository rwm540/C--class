<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DentalCenter.Views.HomeView">

    <Grid Background="#F5F7FA">

        <Border
            Width="850"
            Height="560"
            Background="White"
            CornerRadius="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Margin="30"
                        Spacing="20">

                <!-- تصویر -->
                <Image
                    Source="avares://DentalCenter/Assets/Images/clinic.png"
                    Height="300"
                    Stretch="Uniform"/>

                <!-- عنوان -->
                <TextBlock
                    Text="طراحی ساختمان مرکز دندانپزشکی"
                    FontSize="34"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>

                <TextBlock

                    Text=" رویکرد بهره‌ "
                    FontSize="22"
                    Foreground="#1976D2"
                    HorizontalAlignment="Center"/>

                <Separator Margin="40,5"/>

                <TextBlock
                    Text="دانشجو : ........................................"
                    FontSize="18"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="استاد راهنما : ................................"
                    FontSize="18"
                    HorizontalAlignment="Center"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>