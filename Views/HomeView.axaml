<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DentalCenter.Views.HomeView">

    <Grid Background="#F5F7FA">

        <Border
            Width="850"
            MaxWidth="920"
            Background="White"
            CornerRadius="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="30">

            <StackPanel Spacing="20">

                <Border Height="300"
                        CornerRadius="12"
                        Background="#E3F2FD"
                        ClipToBounds="True">
                    <Panel>
                        <TextBlock Text="🦷"
                                   FontSize="72"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Image x:Name="HeroImage"
                               Stretch="UniformToFill"/>
                    </Panel>
                </Border>

                <TextBlock
                    Text="طراحی ساختمان مرکز دندانپزشکی"
                    FontSize="32"
                    FontWeight="Bold"
                    TextAlignment="Center"
                    TextWrapping="Wrap"/>

                <TextBlock
                    Text="با رویکرد بهره‌وری انرژی"
                    FontSize="22"
                    Foreground="#1976D2"
                    TextAlignment="Center"/>

                <Separator Margin="40,5"/>

                <TextBlock
                    Text="دانشجو : ........................................"
                    FontSize="18"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="استاد راهنما : ................................"
                    FontSize="18"
                    HorizontalAlignment="Center"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
