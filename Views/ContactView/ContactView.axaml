<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DentalCenter.Views.ContactView"
             FlowDirection="RightToLeft">

    <Grid ColumnDefinitions="*,*">

        <!-- ستون راست: اطلاعات تماس -->
        <ScrollViewer Grid.Column="0" Margin="0,0,10,0">

            <StackPanel Spacing="14">

                <TextBlock Text="تماس با ما"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock Text="اطلاعات تماس دست‌اندرکاران پروژه. برای کپی کردن هر مورد، دکمهٔ کنار آن را بزنید."
                           FontSize="13.5"
                           Opacity="0.7"
                           LineHeight="24"
                           TextWrapping="Wrap"/>

                <ItemsControl x:Name="ContactList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*">

                                    <Border Grid.Column="0"
                                            Width="54" Height="54"
                                            CornerRadius="27"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource DcBrandLightBrush}">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="13,0,0,0" Spacing="7">

                                        <TextBlock Text="{Binding Role}"
                                                   FontSize="12.5"
                                                   Opacity="0.6"/>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="16.5"
                                                   FontWeight="Bold"/>

                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="✉" FontSize="14" Opacity="0.6"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       Text="{Binding Email}"
                                                       FontSize="13.5"
                                                       FlowDirection="LeftToRight"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Content="کپی"
                                                    FontSize="12"
                                                    Height="30"
                                                    Padding="12,0"
                                                    Tag="{Binding Email}"
                                                    Click="OnCopyClick"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="☎" FontSize="14" Opacity="0.6"/>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       Text="{Binding Phone}"
                                                       FontSize="13.5"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Content="کپی"
                                                    FontSize="12"
                                                    Height="30"
                                                    Padding="12,0"
                                                    Tag="{Binding Phone}"
                                                    Click="OnCopyClick"/>
                                        </Grid>

                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="card">
                    <StackPanel Spacing="10">

                        <TextBlock Text="اطلاعات پروژه"
                                   FontSize="16.5"
                                   FontWeight="Bold"/>

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="عنوان:" Opacity="0.6" FontSize="13" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TitleText" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="دانشگاه:" Opacity="0.6" FontSize="13" Margin="0,0,10,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UniversityText" FontSize="13" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="سال:" Opacity="0.6" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="YearText" FontSize="13"/>

                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- ستون چپ: فرم ارسال پیام -->
        <Border Grid.Column="1"
                Margin="10,0,0,0"
                CornerRadius="14"
                Padding="18"
                Background="{DynamicResource DcSurfaceAltBrush}">

            <ScrollViewer>

                <StackPanel Spacing="13">

                    <TextBlock Text="ارسال پیام"
                               FontSize="19"
                               FontWeight="Bold"/>

                    <TextBlock Text="پیام شما در پایگاه دادهٔ برنامه ذخیره می‌شود."
                               FontSize="12.5"
                               Opacity="0.65"
                               TextWrapping="Wrap"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="نام و نام خانوادگی" FontSize="12.5" Opacity="0.7"/>
                        <TextBox x:Name="NameBox" Watermark="نام شما"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="ایمیل" FontSize="12.5" Opacity="0.7"/>
                        <TextBox x:Name="EmailBox"
                                 Watermark="name@example.com"
                                 FlowDirection="LeftToRight"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="شماره تماس (اختیاری)" FontSize="12.5" Opacity="0.7"/>
                        <TextBox x:Name="PhoneBox"
                                 Watermark="۰۹۱۲۰۰۰۰۰۰۰"
                                 FlowDirection="LeftToRight"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="موضوع" FontSize="12.5" Opacity="0.7"/>
                        <ComboBox x:Name="SubjectBox"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0">
                            <ComboBoxItem>پرسش عمومی</ComboBoxItem>
                            <ComboBoxItem>درخواست همکاری</ComboBoxItem>
                            <ComboBoxItem>گزارش اشکال</ComboBoxItem>
                            <ComboBoxItem>سایر موارد</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="متن پیام" FontSize="12.5" Opacity="0.7"/>
                        <TextBox x:Name="MessageBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="130"
                                 Watermark="پیام خود را بنویسید..."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="btnSend"
                                Classes="primary"
                                Content="✉  ارسال پیام"
                                Width="150"/>
                        <Button x:Name="btnResetForm"
                                Content="پاک کردن"
                                Width="110"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               FontSize="13"
                               TextWrapping="Wrap"
                               IsVisible="False"/>

                    <Rectangle Height="1" Fill="{DynamicResource DcBorderBrush}" Margin="0,6"/>

                    <TextBlock x:Name="SentCountText"
                               FontSize="12.5"
                               Opacity="0.6"/>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</UserControl>
