<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DentalCenter.MainWindow"
        Width="1280"
        Height="780"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        ShowInTaskbar="True"
        FlowDirection="RightToLeft"
        Background="{DynamicResource DcBackgroundBrush}"
        Title="مرکز دندانپزشکی — طراحی با رویکرد بهره‌وری انرژی">

    <Grid RowDefinitions="74,*,30" ColumnDefinitions="260,*">

        <!-- نوار عنوان -->
        <Border Grid.Row="0" Grid.ColumnSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#0D47A1"/>
                    <GradientStop Offset="1" Color="#1976D2"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0">

                <Border Grid.Column="0"
                        Width="44" Height="44"
                        CornerRadius="12"
                        Background="#33FFFFFF">
                    <TextBlock Text="🦷"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="HeaderTitle"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="White"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HeaderSubtitle"
                               FontSize="12"
                               Foreground="#CFE3FA"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="btnTheme"
                            Classes="header"
                            Content="🌙"
                            ToolTip.Tip="تغییر پوستهٔ روشن / تیره"
                            Width="42" Height="42"/>
                    <Button x:Name="btnAbout"
                            Classes="header"
                            Content="ℹ"
                            ToolTip.Tip="دربارهٔ برنامه"
                            Width="42" Height="42"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- منوی کناری -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource DcSurfaceBrush}"
                BorderBrush="{DynamicResource DcBorderBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="12,16,12,12">

                <TextBlock DockPanel.Dock="Top"
                           Text="بخش‌ها"
                           FontSize="12"
                           Opacity="0.55"
                           Margin="6,0,0,10"/>

                <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,12,0,0">
                    <Rectangle Height="1" Fill="{DynamicResource DcBorderBrush}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="FooterName"
                               FontSize="12"
                               Opacity="0.6"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel x:Name="NavPanel" Spacing="4"/>

            </DockPanel>

        </Border>

        <!-- محتوا -->
        <Border Grid.Row="1" Grid.Column="1"
                Margin="14"
                CornerRadius="16"
                Padding="20"
                Background="{DynamicResource DcSurfaceBrush}"
                BorderBrush="{DynamicResource DcBorderBrush}"
                BorderThickness="1">
            <ContentControl x:Name="MainContent"/>
        </Border>

        <!-- نوار وضعیت -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="{DynamicResource DcSurfaceAltBrush}"
                BorderBrush="{DynamicResource DcBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="16,0">
                <TextBlock Grid.Column="0"
                           x:Name="StatusLeft"
                           FontSize="11.5"
                           Opacity="0.65"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="StatusRight"
                           FontSize="11.5"
                           Opacity="0.65"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>

</Window>
